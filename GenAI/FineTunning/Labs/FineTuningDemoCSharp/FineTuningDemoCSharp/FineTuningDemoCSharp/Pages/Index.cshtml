@page
@model IndexModel
@{
    ViewData["Title"] = "Business Analysis Copilot";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Analysis Chatbot</title>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 45%, #0b3b6e 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .chat-container {
            width: 100%;
            max-width: 760px;
            height: 92vh;
            background: white;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.45);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Header */
        .chat-header {
            background: linear-gradient(120deg, #0b3b6e 0%, #0f5ca8 55%, #14b8a6 100%);
            color: white;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.25);
        }

        .chat-header-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-header-title h1 {
            font-size: 1.3rem;
            margin: 0;
            font-weight: 600;
        }

        .chat-subtitle {
            margin: 0;
            font-size: 0.82rem;
            opacity: 0.92;
        }

        .header-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .header-status {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            background: rgba(255, 255, 255, 0.18);
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .online-indicator {
            width: 10px;
            height: 10px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.6;
            }
        }

        .insight-strip {
            padding: 12px 16px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            background: #eef6ff;
            border-bottom: 1px solid #d7e7fa;
        }

        .insight-card {
            background: white;
            border: 1px solid #dbeafe;
            border-radius: 12px;
            padding: 10px;
        }

        .insight-label {
            font-size: 0.72rem;
            color: #64748b;
            margin-bottom: 2px;
        }

        .insight-value {
            font-size: 0.95rem;
            font-weight: 700;
            color: #0f172a;
        }

        .insight-trend {
            font-size: 0.72rem;
            color: #059669;
        }

        /* Messages Container */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            background: #f8fafc;
        }

        .empty-state {
            border: 1px dashed #bfdbfe;
            background: #eff6ff;
            padding: 14px;
            border-radius: 12px;
            color: #1e3a8a;
            font-size: 0.9rem;
        }

        .message {
            display: flex;
            gap: 10px;
            animation: slideIn 0.3s ease-in-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.user {
            justify-content: flex-end;
        }

        .message-content {
            max-width: 74%;
            padding: 12px 16px;
            border-radius: 16px;
            word-wrap: break-word;
            font-size: 0.93rem;
            line-height: 1.45;
        }

        .message.user .message-content {
            background: linear-gradient(135deg, #0f5ca8 0%, #0b3b6e 100%);
            color: white;
            border-bottom-right-radius: 6px;
            max-width: 150%;
        }

        .message.ai .message-content {
            background: #e2e8f0;
            color: #0f172a;
            border-bottom-left-radius: 6px;
            max-width: 100%;
        }

        .message-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .user-avatar {
            background: linear-gradient(135deg, #334155 0%, #0f172a 100%);
            color: white;
        }

        .ai-avatar {
            background: #dbeafe;
            color: #0b3b6e;
        }

        /* Typing Indicator */
        .typing-indicator {
            display: flex;
            gap: 5px;
            align-items: center;
        }

        .typing-dot {
            width: 8px;
            height: 8px;
            background: #0f5ca8;
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        .typing-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

        @@keyframes typing {
            0%, 60%, 100% {
                opacity: 0.5;
                transform: translateY(0);
            }
            30% {
                opacity: 1;
                transform: translateY(-10px);
            }
        }

        /* Input Area */
        .chat-input-area {
            padding: 12px 14px 14px;
            background: white;
            border-top: 1px solid #e2e8f0;
        }

        .prompt-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }

        .prompt-chip {
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 16px;
            font-size: 0.78rem;
            padding: 5px 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .prompt-chip:hover {
            background: #dbeafe;
        }

        .input-row {
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .message-input {
            flex: 1;
            border: 2px solid #dbeafe;
            border-radius: 18px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-family: inherit;
            transition: border-color 0.3s;
            resize: none;
            max-height: 100px;
        }

        .message-input:focus {
            outline: none;
            border-color: #0f5ca8;
            box-shadow: 0 0 0 3px rgba(15, 92, 168, 0.12);
        }

        .send-btn {
            background: linear-gradient(135deg, #0f5ca8 0%, #0b3b6e 100%);
            border: none;
            color: white;
            border-radius: 12px;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s;
            font-size: 1.05rem;
        }

        .send-btn:hover {
            transform: scale(1.04);
        }

        .send-btn:active {
            transform: scale(0.96);
        }

        .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: scale(1);
        }

        /* Scrollbar */
        .chat-messages::-webkit-scrollbar {
            width: 6px;
        }

        .chat-messages::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .chat-messages::-webkit-scrollbar-thumb {
            background: #0f5ca8;
            border-radius: 3px;
        }

        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: #0b3b6e;
        }

        .timestamp {
            font-size: 0.72rem;
            opacity: 0.7;
            margin-top: 5px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .chat-container {
                max-width: 100%;
                height: 100vh;
                border-radius: 0;
            }

            .message-content {
                max-width: 85%;
            }

            .insight-strip {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="chat-container">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-title">
                <div class="header-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <h1>Business Analysis Chatbot</h1>
                    <p class="chat-subtitle">Strategic insights for decision makers</p>
                </div>
            </div>
            <div class="header-status">
                <div class="online-indicator"></div>
                <span>Live Insights</span>
            </div>
        </div>

        <!-- Messages Area -->
        <div class="chat-messages" id="chatMessages">
            @if (string.IsNullOrWhiteSpace(Model.usermessage) && string.IsNullOrWhiteSpace(Model.airesponse))
            {
                <div class="empty-state">
                    <strong>Start a business conversation:</strong> ask for KPI analysis, risk assessment, market trends, or executive summaries.
                </div>
            }

            @if (Model.usermessage != null && Model.usermessage != "")
            {
                <div class="message user">
                    <div class="message-avatar user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div class="message-content">
                            @Model.usermessage
                        </div>
                        <div class="timestamp">Just now</div>
                    </div>
                </div>
            }

            @if (Model.airesponse != null && Model.airesponse != "")
            {
                <div class="message ai">
                    <div class="message-avatar ai-avatar">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <div class="message-content">
                            @Model.airesponse
                        </div>
                        <div class="timestamp">Just now</div>
                    </div>
                </div>
            }
        </div>

        <!-- Input Area -->
        <div class="chat-input-area">
            <form method="post" id="chatForm">
                <div class="prompt-suggestions">
                    <button type="button" class="prompt-chip" data-prompt="Summarize this month's KPI performance for executives.">KPI executive summary</button>
                    <button type="button" class="prompt-chip" data-prompt="What are the top 3 business risks this quarter and mitigation actions?">Risk assessment</button>
                    <button type="button" class="prompt-chip" data-prompt="Compare forecast vs actual sales and highlight key deviations.">Forecast vs actual</button>
                </div>
                <div class="input-row">
                    <textarea class="message-input"
                              id="messageInput"
                              placeholder="Ask for business insights, trends, risks, or strategic recommendations..."
                              rows="1" name="usermessage"></textarea>
                    <button type="submit" class="send-btn" id="sendBtn" title="Send">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const chatMessages = document.getElementById('chatMessages');
        const chatForm = document.getElementById('chatForm');
        const promptChips = document.querySelectorAll('.prompt-chip');

        messageInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            sendBtn.disabled = this.value.trim().length === 0;
        });

        messageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (messageInput.value.trim().length > 0) {
                    chatForm.submit();
                }
            }
        });

        promptChips.forEach(chip => {
            chip.addEventListener('click', function() {
                messageInput.value = this.dataset.prompt;
                messageInput.dispatchEvent(new Event('input'));
                messageInput.focus();
            });
        });

        function showTypingIndicator() {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message ai';
            messageDiv.id = 'typingIndicator';

            const avatar = document.createElement('div');
            avatar.className = 'message-avatar ai-avatar';
            avatar.innerHTML = '<i class="fas fa-robot"></i>';

            const content = document.createElement('div');
            const typing = document.createElement('div');
            typing.className = 'typing-indicator';
            typing.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';

            content.appendChild(typing);
            messageDiv.appendChild(avatar);
            messageDiv.appendChild(content);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) {
                indicator.remove();
            }
        }

        window.addEventListener('load', function() {
            sendBtn.disabled = true;
            messageInput.focus();
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });
    </script>
</body>
</html>
